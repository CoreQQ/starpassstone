// Prisma schema — the production data model for Starpass Stone.
//
// Used when DATABASE_URL is set (see lib/repo). Without it the app falls back
// to the JSON/Blob store, so the site stays deployable with zero database.

generator client {
  provider = "prisma-client-js"
}

// With Supabase, set DATABASE_URL to the pooled (pgbouncer, port 6543)
// connection string and DIRECT_URL to the direct one (port 5432) — Prisma uses
// the direct connection for migrations. For plain Postgres, set both to the
// same URL (or just DATABASE_URL and omit DIRECT_URL from the env — Prisma
// falls back when the variable equals the primary URL).
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  USER
  ADMIN
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  name      String?
  password  String // bcrypt hash
  role      Role      @default(USER)
  createdAt DateTime  @default(now())
  lastLogin DateTime?
}

model MediaItem {
  id       String @id @default(cuid())
  section  String // products | hamamGallery | saunaGallery
  title    String @default("")
  desc     String @default("")
  img      String
  position Int    @default(0)

  @@index([section, position])
}

model Visit {
  id        String   @id @default(cuid())
  visitorId String
  at        DateTime @default(now())
  path      String
  referrer  String   @default("")
  isNew     Boolean  @default(true)
  duration  Int?
  ip        String   @default("")
  country   String   @default("")
  city      String   @default("")
  provider  String   @default("")
  device    String   @default("")
  os        String   @default("")
  browser   String   @default("")
  language  String   @default("")

  @@index([at])
  @@index([visitorId])
}

model Log {
  id      String   @id @default(cuid())
  at      DateTime @default(now())
  type    String
  message String
  ip      String?

  @@index([at])
}

model News {
  id        String   @id @default(cuid())
  title     String
  body      String
  img       String   @default("")
  published Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model Banner {
  id       String  @id @default(cuid())
  text     String
  href     String  @default("")
  active   Boolean @default(true)
  position Int     @default(0)
}

// Free-form site settings (SEO overrides, toggles) as a key-value store.
model Setting {
  key   String @id
  value String
}
