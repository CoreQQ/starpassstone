# ─── Обязательные ─────────────────────────────────────────────
# Ключ Claude API: https://platform.claude.com → API Keys
ANTHROPIC_API_KEY=sk-ant-...

# Токен Telegram-бота: создайте бота у @BotFather командой /newbot
TELEGRAM_BOT_TOKEN=123456789:AA...

# ─── Настоятельно рекомендуется ───────────────────────────────
# ID вашей Telegram-группы (отрицательное число, например -1001234567890).
# Как узнать: добавьте бота в группу, напишите сообщение и откройте
# https://api.telegram.org/bot<ТОКЕН>/getUpdates — там будет chat.id
TELEGRAM_GROUP_ID=

# ─── Необязательные ───────────────────────────────────────────
# Модель Claude для агентов.
# claude-sonnet-5 (по умолчанию) — быстро и недорого;
# claude-opus-4-8 — максимум ума, в ~2.5 раза дороже.
AGENT_MODEL=claude-sonnet-5

# Скорость vs вдумчивость агентов: low = быстро (по умолчанию), medium, high
AGENT_EFFORT=low

# Модель диспетчера (кто должен ответить) — быстрая и дешёвая
ROUTER_MODEL=claude-haiku-4-5

# Как агентам к вам обращаться
OWNER_NAME=Владелец

# Часовой пояс (по Италии) и час вечернего отчёта
TIMEZONE=Europe/Rome
EVENING_HOUR=19

# Утренняя планёрка по расписанию ВЫКЛЮЧЕНА по умолчанию — проводите её
# командой /standup, когда нужно. Чтобы включить ежедневную, задайте час:
# MORNING_HOUR=9

# ─── Рекламный кабинет Meta (Facebook/Instagram) — опционально ────────
# Если заданы, Марк сам управляет рекламой: смотрит кампании и статистику,
# создаёт кампании (всегда на паузе), включает/меняет бюджет — но только
# с вашего явного согласия. Токен и ID кабинета берутся в Meta Business:
# developers.facebook.com → приложение → Marketing API → Access Token.
# META_ACCESS_TOKEN=EAAG...
# META_AD_ACCOUNT_ID=act_1234567890
# META_API_VERSION=v23.0

# ─── Почта — опционально ──────────────────────────────────────────────
# ОТПРАВКА писем. Рекомендуется Brevo (HTTP API) — работает на Railway и
# других хостингах, где SMTP заблокирован. Настройка:
#   1) Зарегистрируйтесь на brevo.com (бесплатно ~300 писем/день)
#   2) Settings → SMTP & API → API Keys → создайте ключ → BREVO_API_KEY
#   3) Senders → добавьте и подтвердите ваш адрес-отправитель (тот же MAIL_USER)
# MAIL_USER — ваш адрес-отправитель (напр. starpass.it@gmail.com)
# BREVO_API_KEY=xkeysib-...
# MAIL_USER=starpass.it@gmail.com
# MAIL_FROM_NAME=Starpass Stone
#
# Альтернатива — прямой SMTP (НЕ работает на Railway из-за блокировки портов;
# годится для VPS/Fly.io). Пароль Gmail — только «App Password», не обычный.
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=465
#   MAIL_PASSWORD=xxxxxxxxxxxxxxxx
#
# ЧТЕНИЕ входящих (уведомления об ответах клиентов) — по IMAP:
#   IMAP_HOST=imap.gmail.com
#   IMAP_PORT=993
#   MAIL_PASSWORD=xxxxxxxxxxxxxxxx   (App Password Gmail)
# MAIL_POLL_MINUTES=3
#
# О чём уведомлять в группе (чтобы рассылки не мешали):
#   replies — только ответы от адресов, которым мы уже писали (по умолчанию)
#   off     — вообще не уведомлять о входящих
#   all     — обо всех письмах
# MAIL_NOTIFY=replies

# Описание вашего бизнеса своими словами (агенты будут его учитывать).
# По умолчанию — профиль Starpass Stone.
# BUSINESS_PROFILE=Мастерская по изделиям из натурального камня в ...

# Куда сохранять память агентов (задачи, уроки, историю).
# Локально можно не задавать. На Railway/Render укажите путь
# смонтированного volume, иначе память сотрётся при редеплое:
# DATA_DIR=/data
